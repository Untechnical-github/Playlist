# score_playlist.py 用の設定。このファイルをコピーして .env という名前で保存し、値を埋める。
# .env はコミットしないこと（.gitignore 済み）。

# YouTube Data API v3 のAPIキー（Google Cloud Console → 認証情報 → APIキー）
YOUTUBE_API_KEY=

# ytmusicapi の browser 認証ファイルのパス（省略時は auth/headers_auth.json）
# 無くても限定公開/公開プレイリストなら認証なしで取得できる
YTMUSIC_AUTH_FILE=auth/headers_auth.json
